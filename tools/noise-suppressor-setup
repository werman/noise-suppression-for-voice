#!/usr/bin/env python3
"""Terminal UI to set up "Noise Suppressor for Voice" as a PipeWire virtual microphone.

The tool writes a filter-chain config for the LADSPA plugin and runs it with the
PipeWire "filter-chain.service" (PipeWire 0.3.57 or later, with systemd). Without that
service, it writes the config to pipewire.conf.d (PipeWire 0.3.45 or later), and the
main PipeWire daemon runs it. It can also run an echo test with the current
settings, before they are applied. The echo test does not need systemd.

The plugin must be installed in a LADSPA search path, for example /usr/lib/ladspa.
Only the Python standard library and the PipeWire command line tools are necessary.
"""

import argparse
import curses
import json
import math
import os
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import time
import wave
from array import array

TOOL_NAME = "noise-suppressor-setup"
SETTINGS_MARKER = "# noise-suppressor-setup settings: "
CONFIG_FILE_NAME = "99-noise-suppressor.conf"
PLUGIN_FILE_NAME = "librnnoise_ladspa.so"

SOURCE_NODE_NAME = "rnnoise_source"
CAPTURE_NODE_NAME = "capture.rnnoise_source"
TEST_SOURCE_NODE_NAME = "rnnoise_echo_test_source"
TEST_CAPTURE_NODE_NAME = "capture.rnnoise_echo_test_source"
OWN_NODE_NAMES = {SOURCE_NODE_NAME, CAPTURE_NODE_NAME, TEST_SOURCE_NODE_NAME, TEST_CAPTURE_NODE_NAME}

DEFAULT_TARGET = ""

# Run the filter in filter-chain.service, with the config in filter-chain.conf.d.
MODE_FILTER_CHAIN = "filter-chain"
# Run the filter in the main PipeWire daemon, with the config in pipewire.conf.d.
MODE_PIPEWIRE = "pipewire"

# PipeWire 0.3.45 loads conf.d directories. 0.3.57 adds filter-chain.service.
MIN_CONF_D_VERSION = (0, 3, 45)
MIN_FILTER_CHAIN_SERVICE_VERSION = (0, 3, 57)

DEFAULT_SETTINGS = {
    "target": DEFAULT_TARGET,
    "stereo": False,
    "vad_threshold": 85,
    "vad_grace_ms": 200,
    "retroactive_grace_ms": 0,
    "dry_mix": 0.0,
    "description": "Noise Canceling source",
    "make_default": False,
    "test_seconds": 5,
}


# ---------------------------------------------------------------------------
# Paths and environment


def config_home():
    return os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")


def filter_chain_conf_d_dir():
    return os.path.join(config_home(), "pipewire", "filter-chain.conf.d")


def pipewire_conf_d_dir():
    return os.path.join(config_home(), "pipewire", "pipewire.conf.d")


def config_path(mode):
    directory = filter_chain_conf_d_dir() if mode == MODE_FILTER_CHAIN else pipewire_conf_d_dir()
    return os.path.join(directory, CONFIG_FILE_NAME)


def ladspa_search_dirs(ladspa_path):
    """Returns the directories in the order that PipeWire uses.
    If LADSPA_PATH is set, PipeWire uses only it.
    """
    env = [d for d in (ladspa_path or "").split(":") if d]
    if env:
        return env
    return ["/usr/lib64/ladspa", "/usr/lib/ladspa", "/usr/lib/x86_64-linux-gnu/ladspa",
            "/usr/lib/aarch64-linux-gnu/ladspa"]


def find_plugin(ladspa_path):
    for directory in ladspa_search_dirs(ladspa_path):
        path = os.path.join(directory, PLUGIN_FILE_NAME)
        if os.path.isfile(path):
            return path
    return None


def find_plugin_outside_search_path():
    """Returns a plugin copy that PipeWire does not load, or None. This helps to explain a missing plugin."""
    home = os.path.expanduser("~")
    for directory in [os.path.join(home, ".ladspa"), "/usr/local/lib/ladspa", "/usr/local/lib64/ladspa"]:
        path = os.path.join(directory, PLUGIN_FILE_NAME)
        if os.path.isfile(path):
            return path
    return None


def missing_tools():
    """Returns the missing commands that the echo test and apply need. systemctl is optional."""
    tools = ["pipewire", "pw-dump", "pw-record", "pw-play"]
    return [tool for tool in tools if shutil.which(tool) is None]


def run(args, timeout=15):
    """Runs a command. Returns (exit code, combined output)."""
    try:
        result = subprocess.run(args, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                universal_newlines=True, timeout=timeout)
        return result.returncode, result.stdout.strip()
    except (OSError, subprocess.TimeoutExpired) as error:
        return 1, str(error)


# ---------------------------------------------------------------------------
# PipeWire queries


def pw_dump():
    code, output = run(["pw-dump"])
    if code != 0:
        return []
    try:
        return json.loads(output)
    except ValueError:
        return []


def audio_nodes(objects=None):
    """Returns the audio nodes as a list of dicts with id, name, description, media_class and channels."""
    nodes = []
    for obj in objects if objects is not None else pw_dump():
        if obj.get("type") != "PipeWire:Interface:Node":
            continue
        props = obj.get("info", {}).get("props", {})
        media_class = props.get("media.class", "")
        if not media_class.startswith(("Audio/", "Stream/Input/Audio")):
            continue
        nodes.append({
            "id": obj.get("id"),
            "name": props.get("node.name", ""),
            "description": props.get("node.description") or props.get("node.nick") or props.get("node.name", ""),
            "media_class": media_class,
            "channels": props.get("audio.channels"),
            "priority": props.get("priority.session") or 0,
        })
    return nodes


def microphones(objects=None):
    """Returns the hardware and virtual sources, except the sources of this tool."""
    return [node for node in audio_nodes(objects)
            if node["media_class"] == "Audio/Source" and node["name"] not in OWN_NODE_NAMES]


def linked_source_name(node_name, objects):
    """Returns the name of the microphone that is linked to the input of a node, or None."""
    node = find_node(node_name, objects)
    if node is None:
        return None
    names = {mic["id"]: mic["name"] for mic in microphones(objects)}
    for obj in objects:
        if obj.get("type") != "PipeWire:Interface:Link":
            continue
        info = obj.get("info", {})
        if info.get("input-node-id") == node["id"] and info.get("output-node-id") in names:
            return names[info["output-node-id"]]
    return None


def find_node(name, objects=None):
    for node in audio_nodes(objects):
        if node["name"] == name:
            return node
    return None


def default_source_name(objects=None):
    for obj in objects if objects is not None else pw_dump():
        if obj.get("type") != "PipeWire:Interface:Metadata":
            continue
        for item in obj.get("metadata") or []:
            if item.get("key") == "default.audio.source":
                value = item.get("value")
                if isinstance(value, dict):
                    return value.get("name")
                try:
                    return json.loads(value).get("name")
                except (TypeError, ValueError, AttributeError):
                    return None
    return None


def wait_for_node(name, timeout):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        node = find_node(name)
        if node is not None:
            return node
        time.sleep(0.2)
    return None


# ---------------------------------------------------------------------------
# System detection


def pipewire_version():
    """Returns the version of the PipeWire library as a tuple, or None if it is not known."""
    _, output = run(["pipewire", "--version"])
    # The linked library is the one that runs. Old versions print only one line.
    match = (re.search(r"Linked with libpipewire\s+(\d+)\.(\d+)\.(\d+)", output)
             or re.search(r"libpipewire\s+(\d+)\.(\d+)\.(\d+)", output))
    if match is None:
        return None
    return tuple(int(part) for part in match.groups())


def version_text(version):
    return ".".join(str(part) for part in version) if version else "unknown"


def version_at_least(version, minimum):
    """An unknown version counts as new."""
    return version is None or version >= minimum


def systemctl_user(*args):
    if shutil.which("systemctl") is None:
        return 1, "systemctl is not installed"
    return run(["systemctl", "--user"] + list(args), timeout=30)


def unit_exists(unit):
    code, _ = systemctl_user("cat", unit)
    return code == 0


def unit_active(unit):
    code, output = systemctl_user("is-active", unit)
    return code == 0 and output.splitlines()[-1:] == ["active"]


def daemon_ladspa_path(pipewire_service):
    """Returns LADSPA_PATH of the PipeWire daemon.
    A systemd service gets the environment of the systemd user manager, not of this shell.
    """
    if not pipewire_service:
        return os.environ.get("LADSPA_PATH", "")
    code, output = systemctl_user("show-environment")
    if code != 0:
        return os.environ.get("LADSPA_PATH", "")
    for line in output.splitlines():
        if line.startswith("LADSPA_PATH="):
            return line[len("LADSPA_PATH="):]
    return ""


def pulseaudio_server():
    """Returns the server name if a real PulseAudio (not pipewire-pulse) runs, else None."""
    if shutil.which("pactl") is None:
        return None
    code, output = run(["pactl", "info"], timeout=5)
    if code != 0:
        return None
    match = re.search(r"^Server Name:\s*(.+)$", output, re.MULTILINE)
    if match and "pipewire" not in match.group(1).lower():
        return match.group(1).strip()
    return None


def has_sound_devices(objects):
    """Returns True if PipeWire runs at least one ALSA or Bluetooth device node."""
    for obj in objects:
        if obj.get("type") != "PipeWire:Interface:Node":
            continue
        props = obj.get("info", {}).get("props", {})
        if props.get("device.api") in ("alsa", "bluez5") or props.get("api.alsa.path"):
            return True
    return False


def detect_setup(objects):
    """Returns a dict that describes how this system runs PipeWire.

    mode: MODE_FILTER_CHAIN, MODE_PIPEWIRE, or None if the tool cannot apply a config.
    version_problem: why apply cannot work, or None. The echo test can still work.
    server_problems: why neither apply nor the echo test can work.
    """
    version = pipewire_version()
    pipewire_service = unit_active("pipewire.service")
    filter_chain_unit = pipewire_service and unit_exists("filter-chain.service")

    if (pipewire_service and filter_chain_unit
            and version_at_least(version, MIN_FILTER_CHAIN_SERVICE_VERSION)):
        mode = MODE_FILTER_CHAIN
    elif version_at_least(version, MIN_CONF_D_VERSION):
        mode = MODE_PIPEWIRE
    else:
        mode = None

    version_problem = None
    if mode is None:
        version_problem = "PipeWire {} is too old to apply a config. Apply needs {} or later.".format(
            version_text(version), version_text(MIN_CONF_D_VERSION))
    problems = []
    pulseaudio = pulseaudio_server()
    if pulseaudio:
        problems.append("The sound server is {}, not PipeWire. Apps do not see PipeWire sources.".format(pulseaudio))
    elif not has_sound_devices(objects):
        problems.append("PipeWire has no sound devices. Is PipeWire the sound server of this session?")

    return {
        "version": version,
        "mode": mode,
        "pipewire_service": pipewire_service,
        "filter_chain_unit": filter_chain_unit,
        "shell_ladspa_path": os.environ.get("LADSPA_PATH", ""),
        "daemon_ladspa_path": daemon_ladspa_path(pipewire_service),
        "version_problem": version_problem,
        "server_problems": problems,
    }


def setup_description(setup):
    version = version_text(setup["version"])
    if setup["mode"] == MODE_FILTER_CHAIN:
        return "PipeWire {}, filter-chain.service".format(version)
    if setup["mode"] == MODE_PIPEWIRE:
        reason = "no filter-chain.service"
        if not setup["pipewire_service"]:
            reason = "PipeWire does not run as a systemd service"
        elif not version_at_least(setup["version"], MIN_FILTER_CHAIN_SERVICE_VERSION):
            reason = "filter-chain.service needs PipeWire {}".format(
                version_text(MIN_FILTER_CHAIN_SERVICE_VERSION))
        return "PipeWire {}, main daemon via pipewire.conf.d ({})".format(version, reason)
    return "PipeWire {}, not supported".format(version)


# ---------------------------------------------------------------------------
# Config generation


def latency_ms(settings):
    return 30 + settings["retroactive_grace_ms"] // 10 * 10


def quote(text):
    return '"' + str(text).replace("\\", "\\\\").replace('"', '\\"') + '"'


def filter_chain_module(settings, source_name, capture_name, description, nofail=False):
    """Returns the filter-chain module entry in the PipeWire SPA-JSON format.
    With nofail, PipeWire continues to run when the module cannot load.
    """
    label = "noise_suppressor_stereo" if settings["stereo"] else "noise_suppressor_mono"
    # Always set the channel positions. Without a position, PipeWire maps a stereo
    # microphone to the mono input at half level (-6 dB).
    if settings["stereo"]:
        channels = "            audio.channels = 2\n            audio.position = [ FL FR ]\n"
    else:
        channels = "            audio.channels = 1\n            audio.position = [ MONO ]\n"
    target = ""
    if settings["target"]:
        # WirePlumber before 0.4.10 and pipewire-media-session read only node.target.
        # Newer versions read target.object.
        target = "            target.object = {0}\n            node.target = {0}\n".format(quote(settings["target"]))

    return """{{   name = libpipewire-module-filter-chain
    args = {{
        node.description = {description}
        media.name = {description}
        filter.graph = {{
            nodes = [
                {{
                    type = ladspa
                    name = rnnoise
                    plugin = librnnoise_ladspa
                    label = {label}
                    control = {{
                        "VAD Threshold (%)" = {vad_threshold:.1f}
                        "VAD Grace Period (ms)" = {vad_grace}
                        "Retroactive VAD Grace (ms)" = {retro}
                        "Dry Mix" = {dry_mix:.2f}
                    }}
                }}
            ]
        }}
        capture.props = {{
            node.name = {capture_name}
            node.passive = true
            audio.rate = 48000
{channels}{target}        }}
        playback.props = {{
            node.name = {source_name}
            media.class = Audio/Source
            audio.rate = 48000
{channels}        }}
    }}
{flags}}}""".format(description=quote(description), label=label,
             vad_threshold=float(settings["vad_threshold"]), vad_grace=int(settings["vad_grace_ms"]),
             retro=int(settings["retroactive_grace_ms"]),
             dry_mix=float(settings["dry_mix"]), capture_name=quote(capture_name),
             source_name=quote(source_name), channels=channels, target=target,
             flags="    flags = [ nofail ]\n" if nofail else "")


def generate_config(settings):
    saved = {key: settings[key] for key in DEFAULT_SETTINGS}
    # A broken filter must not stop the other modules in the same daemon.
    # In pipewire.conf.d, that is all audio.
    module = filter_chain_module(settings, SOURCE_NODE_NAME, CAPTURE_NODE_NAME, settings["description"],
                                 nofail=True)
    return ("# Generated by {tool}. Changes in this file are lost when the tool saves it again.\n"
            "{marker}{saved}\n"
            "# Latency: {latency} ms.\n"
            "context.modules = [\n{module}\n]\n").format(
        tool=TOOL_NAME, marker=SETTINGS_MARKER, saved=json.dumps(saved, sort_keys=True),
        latency=latency_ms(settings), module=module)


def generate_test_config(settings):
    """Returns a full config for a separate "pipewire -c" process, used by the echo test."""
    module = filter_chain_module(settings, TEST_SOURCE_NODE_NAME, TEST_CAPTURE_NODE_NAME,
                                 "Noise Suppressor echo test")
    return """context.properties = {{
    log.level = 2
}}
context.spa-libs = {{
    audio.convert.* = audioconvert/libspa-audioconvert
    support.*       = support/libspa-support
}}
context.modules = [
    {{ name = libpipewire-module-rt
        args = {{ }}
        flags = [ ifexists nofail ]
    }}
    {{ name = libpipewire-module-protocol-native }}
    {{ name = libpipewire-module-client-node }}
    {{ name = libpipewire-module-adapter }}
{module}
]
""".format(module=module)


def clamp_settings(settings):
    result = dict(DEFAULT_SETTINGS)
    result.update({key: value for key, value in settings.items() if key in DEFAULT_SETTINGS})
    result["vad_threshold"] = int(min(max(float(result["vad_threshold"]), 0), 99))
    result["vad_grace_ms"] = int(min(max(float(result["vad_grace_ms"]), 0), 1000))
    result["retroactive_grace_ms"] = int(min(max(float(result["retroactive_grace_ms"]), 0), 200)) // 10 * 10
    result["dry_mix"] = round(min(max(float(result["dry_mix"]), 0.0), 1.0), 2)
    result["test_seconds"] = int(min(max(float(result["test_seconds"]), 2), 30))
    result["stereo"] = bool(result["stereo"])
    result["make_default"] = bool(result["make_default"])
    result["target"] = str(result["target"] or "")
    result["description"] = str(result["description"] or DEFAULT_SETTINGS["description"])
    return result


def parse_config_text(text):
    """Reads settings from a config. It reads the settings line of this tool,
    or the values of a hand-written config, as in the README.
    """
    for line in text.splitlines():
        if line.startswith(SETTINGS_MARKER):
            try:
                return clamp_settings(json.loads(line[len(SETTINGS_MARKER):]))
            except (ValueError, TypeError):
                break

    settings = dict(DEFAULT_SETTINGS)
    patterns = {
        "vad_threshold": r'"VAD Threshold \(%\)"\s*=\s*([0-9.]+)',
        "vad_grace_ms": r'"VAD Grace Period \(ms\)"\s*=\s*([0-9.]+)',
        "retroactive_grace_ms": r'"Retroactive VAD Grace \(ms\)"\s*=\s*([0-9.]+)',
        "dry_mix": r'"Dry Mix"\s*=\s*([0-9.]+)',
    }
    for key, pattern in patterns.items():
        match = re.search(pattern, text)
        if match:
            settings[key] = float(match.group(1))
    match = re.search(r'target\.object\s*=\s*"?([^"\s}]+)"?', text)
    if match:
        settings["target"] = match.group(1)
    match = re.search(r'node\.description\s*=\s*"([^"]*)"', text)
    if match:
        settings["description"] = match.group(1)
    settings["stereo"] = "noise_suppressor_stereo" in text
    return clamp_settings(settings)


def is_own_config(text):
    return SETTINGS_MARKER in text


def conflicting_configs(mode):
    """Returns the configs in pipewire.conf.d that load this plugin, except the config of this mode.
    They conflict with the config of this tool.
    """
    directory = pipewire_conf_d_dir()
    own_path = config_path(mode)
    found = []
    try:
        names = sorted(os.listdir(directory))
    except OSError:
        return found
    for name in names:
        path = os.path.join(directory, name)
        if path == own_path or not name.endswith(".conf") or not os.path.isfile(path):
            continue
        try:
            with open(path) as config:
                if "librnnoise_ladspa" in config.read():
                    found.append(path)
        except OSError:
            pass
    return found


def read_text(path):
    """Returns the content of a file, or None if it does not exist."""
    try:
        with open(path) as file:
            return file.read()
    except OSError:
        return None


def load_settings(mode):
    """Returns (settings, source). The source is the file the settings come from, or None."""
    # Prefer a config that this tool wrote, for example in the other mode, to a hand-written one.
    others = sorted(conflicting_configs(mode), key=lambda path: not is_own_config(read_text(path) or ""))
    for path in [config_path(mode)] + others:
        text = read_text(path)
        if text is not None:
            return parse_config_text(text), path
    return dict(DEFAULT_SETTINGS), None


def write_text(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    temp_path = path + ".tmp"
    with open(temp_path, "w") as file:
        file.write(text)
    os.replace(temp_path, path)


def write_config(settings, mode):
    """Writes the config. Makes a backup of a file that this tool did not write. Returns the backup path."""
    path = config_path(mode)
    backup = None
    old_text = read_text(path)
    if old_text is not None and not is_own_config(old_text):
        backup = path + ".bak-" + time.strftime("%Y%m%d-%H%M%S")
        shutil.copy2(path, backup)
    write_text(path, generate_config(settings))
    return backup


def other_filter_chain_configs():
    try:
        return [name for name in os.listdir(filter_chain_conf_d_dir())
                if name.endswith(".conf") and name != CONFIG_FILE_NAME]
    except OSError:
        return []


# ---------------------------------------------------------------------------
# Services

APPLY_OK = "ok"
APPLY_FAILED = "failed"
# The config is written, but the user must restart PipeWire.
APPLY_MANUAL = "manual"

MANUAL_RESTART_TEXT = "Restart PipeWire to load the config, for example log out and log in again."


def service_unit(mode):
    return "filter-chain.service" if mode == MODE_FILTER_CHAIN else "pipewire.service"


def service_state():
    _, active = systemctl_user("is-active", "filter-chain.service")
    _, enabled = systemctl_user("is-enabled", "filter-chain.service")
    return active.splitlines()[-1] if active else "unknown", enabled.splitlines()[-1] if enabled else "unknown"


def journal_errors(unit, since, count=4):
    """Returns the last warning and error lines of a unit since a time.time() value."""
    if shutil.which("journalctl") is None:
        return []
    args = ["journalctl", "--user", "-u", unit, "--since", "@{}".format(int(since)), "-o", "cat", "--no-pager"]
    code, output = run(args + ["-p", "warning"])
    lines = output.splitlines() if code == 0 else []
    if not lines:
        # Some setups log all lines with the same priority. Search the text.
        code, output = run(args)
        lines = [line for line in output.splitlines()
                 if code == 0 and re.search(r"\[E\]|\[W\]|error|fail", line, re.IGNORECASE)]
    return [line for line in lines if "-- No entries --" not in line][-count:]


def restart_pipewire(setup, log):
    """Restarts the main PipeWire daemon. Returns APPLY_OK, APPLY_FAILED or APPLY_MANUAL."""
    if not setup["pipewire_service"]:
        log(MANUAL_RESTART_TEXT)
        return APPLY_MANUAL
    log("Restarting pipewire.service. All audio stops for a moment...")
    code, output = systemctl_user("restart", "pipewire.service")
    if code != 0:
        log("Cannot restart pipewire.service: " + output)
        return APPLY_FAILED
    time.sleep(1.0)
    return APPLY_OK


def apply_settings(settings, setup, disable_conflicts, log):
    """Writes the config and restarts the service that runs it.
    Returns APPLY_OK, APPLY_FAILED or APPLY_MANUAL.
    """
    mode = setup["mode"]
    started = time.time()
    backup = write_config(settings, mode)
    log("Config written: " + config_path(mode))
    if backup:
        log("Old file saved as: " + backup)

    need_pipewire_restart = mode == MODE_PIPEWIRE
    if disable_conflicts:
        for path in conflicting_configs(mode):
            disabled = path + ".disabled"
            os.replace(path, disabled)
            log("Old config disabled: " + disabled)
            need_pipewire_restart = True

    if need_pipewire_restart:
        result = restart_pipewire(setup, log)
        if result != APPLY_OK:
            return result

    if mode == MODE_FILTER_CHAIN:
        code, output = systemctl_user("enable", "filter-chain.service")
        if code != 0:
            log("Cannot enable filter-chain.service: " + output)
            return APPLY_FAILED
        log("Restarting filter-chain.service...")
        code, output = systemctl_user("restart", "filter-chain.service")
        if code != 0:
            log("Cannot restart filter-chain.service: " + output)
            return APPLY_FAILED

    unit = service_unit(mode)
    node = wait_for_node(SOURCE_NODE_NAME, 10.0)
    if node is None:
        log("The source did not appear. See: journalctl --user -u " + unit)
        for line in journal_errors(unit, started):
            log("  " + line)
        return APPLY_FAILED
    log("Source is running: {} (node {})".format(settings["description"], node["id"]))

    if settings["make_default"]:
        if shutil.which("wpctl") is None:
            log("Cannot set the default input: wpctl is not installed.")
        else:
            code, output = run(["wpctl", "set-default", str(node["id"])])
            log("Set as default input." if code == 0 else "Cannot set the default input: " + output)
    return APPLY_OK


def restore_config(setup, old_text, log):
    """Writes back the config from before apply, or removes the config if there was none."""
    path = config_path(setup["mode"])
    if old_text is None:
        if os.path.exists(path):
            os.remove(path)
        log("New config removed: " + path)
    else:
        write_text(path, old_text)
        log("Previous config restored: " + path)
    if setup["mode"] == MODE_FILTER_CHAIN:
        systemctl_user("restart", "filter-chain.service")
    else:
        restart_pipewire(setup, log)


def remove_setup(setup, log):
    mode = setup["mode"]
    path = config_path(mode)
    if os.path.exists(path):
        os.remove(path)
        log("Config removed: " + path)
    else:
        log("No config to remove.")
    if mode == MODE_PIPEWIRE:
        restart_pipewire(setup, log)
    elif other_filter_chain_configs():
        log("Other filter-chain configs exist. Restarting filter-chain.service...")
        systemctl_user("restart", "filter-chain.service")
    else:
        log("Stopping and disabling filter-chain.service...")
        systemctl_user("disable", "--now", "filter-chain.service")
    return True


