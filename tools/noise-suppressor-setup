def wav_level_db(path, skip_seconds=0.3):
    """Returns (RMS dB, 10th percentile of 50 ms RMS dB) for a 16-bit WAV file.
    The percentile shows the noise floor in pauses.
    """
    try:
        with wave.open(path, "rb") as wav:
            if wav.getsampwidth() != 2:
                return None
            rate = wav.getframerate()
            channels = wav.getnchannels()
            samples = array("h")
            samples.frombytes(wav.readframes(wav.getnframes()))
    except (OSError, EOFError, wave.Error):
        return None
    if sys.byteorder == "big":
        samples.byteswap()
    samples = samples[int(skip_seconds * rate) * channels:]
    if not samples:
        return None

    def to_db(sum_squares, count):
        if count == 0 or sum_squares <= 0:
            return -120.0
        return max(10 * math.log10(sum_squares / count / (32768.0 * 32768.0)), -120.0)

    window = max(int(rate * 0.05) * channels, 1)
    windows = []
    total = 0.0
    for start in range(0, len(samples), window):
        part = samples[start:start + window]
        energy = float(sum(s * s for s in part))
        total += energy
        windows.append(to_db(energy, len(part)))
    windows.sort()
    return to_db(total, len(samples)), windows[len(windows) // 10]


class EchoTest:
    """Runs a temporary filter chain with the given settings. Records the raw and the denoised input."""

    def __init__(self, settings, raw_target):
        # The test filter reads the same microphone as the raw recording.
        # Thus it never reads the installed denoised source.
        self.settings = dict(settings, target=raw_target)
        self.raw_target = raw_target
        self.directory = tempfile.mkdtemp(prefix="noise-suppressor-echo-")
        self.raw_path = os.path.join(self.directory, "raw.wav")
        self.denoised_path = os.path.join(self.directory, "denoised.wav")
        self.log_path = os.path.join(self.directory, "pipewire.log")
        self.chain = None
        self.recorders = []

    def start_chain(self):
        config = os.path.join(self.directory, "echo-test.conf")
        with open(config, "w") as file:
            file.write(generate_test_config(self.settings))
        with open(self.log_path, "w") as log:
            self.chain = subprocess.Popen(["pipewire", "-c", config], stdout=log, stderr=subprocess.STDOUT)
        deadline = time.monotonic() + 5.0
        while time.monotonic() < deadline:
            # A config error stops the process at once. Do not wait for the timeout then.
            if self.chain.poll() is not None:
                break
            if find_node(TEST_SOURCE_NODE_NAME) is not None:
                return True
            time.sleep(0.2)
        self.stop()
        return False

    def error_lines(self, count=3):
        """Returns the last error lines of the test PipeWire process. The most specific error is first."""
        text = read_text(self.log_path) or ""
        errors = [line for line in text.splitlines() if line.startswith("[E]")]
        if not errors:
            errors = [line for line in text.splitlines() if line.strip()][-count:]
        # Remove the "[E][time] topic | [file:line function()]" prefix. Old versions have no topic.
        prefix = r"^\[E\]\[[^\]]*\]\s*(\S+\s*\|\s*)?(\[[^\]]*\]\s*)?"
        return [re.sub(prefix, "", line).strip() for line in errors[:count]]

    def start_recording(self):
        channels = "2" if self.settings["stereo"] else "1"
        common = ["pw-record", "--rate", "48000", "--channels", channels, "--format", "s16"]
        self.recorders = [
            subprocess.Popen(common + ["--target", self.raw_target, self.raw_path],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL),
            subprocess.Popen(common + ["--target", TEST_SOURCE_NODE_NAME, self.denoised_path],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL),
        ]

    def stop_recording(self):
        # SIGINT lets pw-record finish the WAV header.
        for recorder in self.recorders:
            if recorder.poll() is None:
                recorder.send_signal(signal.SIGINT)
        for recorder in self.recorders:
            try:
                recorder.wait(timeout=3)
            except subprocess.TimeoutExpired:
                recorder.kill()
        self.recorders = []

    def stop(self):
        self.stop_recording()
        if self.chain is not None and self.chain.poll() is None:
            self.chain.terminate()
            try:
                self.chain.wait(timeout=3)
            except subprocess.TimeoutExpired:
                self.chain.kill()
        self.chain = None

    def cleanup(self):
        self.stop()
        shutil.rmtree(self.directory, ignore_errors=True)


def resolve_raw_target(settings, objects=None):
    """Returns the node name of the real microphone for the echo test, or None."""
    if settings["target"]:
        return settings["target"]
    if objects is None:
        objects = pw_dump()
    name = default_source_name(objects)
    if name and name not in OWN_NODE_NAMES:
        return name
    # The default input is the denoised source. Use the microphone of the installed filter.
    name = linked_source_name(CAPTURE_NODE_NAME, objects)
    if name:
        return name
    # Use the microphone that PipeWire would select first.
    mics = sorted(microphones(objects), key=lambda mic: mic["priority"], reverse=True)
    return mics[0]["name"] if mics else None


