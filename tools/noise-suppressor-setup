class App:
    def __init__(self, screen):
        self.screen = screen
        self.selected = 0
        self.messages = []
        self.devices = []
        self.refresh_status()
        self.settings, self.loaded_from = load_settings(self.mode)
        if self.loaded_from:
            self.message("Settings loaded from " + self.loaded_from)
        if self.loaded_from and self.loaded_from in self.conflicts:
            self.message("This is another config in pipewire.conf.d. Apply replaces it with " +
                         config_path(self.mode))

    # -- state

    def refresh_status(self):
        objects = pw_dump()
        self.setup = detect_setup(objects)
        # Apply uses the mode of filter-chain.service if the tool cannot apply at all.
        # Then the paths in the UI are still valid.
        self.mode = self.setup["mode"] or MODE_FILTER_CHAIN
        self.devices = microphones(objects)
        self.default_source = default_source_name(objects)
        self.running_node = find_node(SOURCE_NODE_NAME, objects)
        # The PipeWire daemon and the echo test can see different LADSPA_PATH values.
        self.plugin_path = find_plugin(self.setup["daemon_ladspa_path"])
        self.test_plugin_path = find_plugin(self.setup["shell_ladspa_path"])
        self.service = service_state() if self.setup["mode"] == MODE_FILTER_CHAIN else None
        self.conflicts = conflicting_configs(self.mode)

    def target_missing(self):
        """Returns True if the selected microphone is not connected."""
        target = self.settings["target"]
        return bool(target) and target not in [device["name"] for device in self.devices]

    def message(self, text):
        self.messages.append(text)
        self.messages = self.messages[-6:]

    def device_label(self, name):
        if not name:
            label = "System default input"
            if self.default_source:
                label += " (now: {})".format(self.describe_node(self.default_source))
            return label
        return self.describe_node(name)

    def describe_node(self, name):
        for device in self.devices:
            if device["name"] == name:
                return device["description"]
        if name == SOURCE_NODE_NAME:
            return self.settings["description"] + " (this filter)"
        return name + " (not connected)"

    def value_text(self, field):
        value = self.settings[field.key]
        if field.key == "target":
            return self.device_label(value)
        if field.key == "stereo":
            return "Stereo" if value else "Mono"
        if field.kind == "bool":
            return "Yes" if value else "No"
        if field.kind == "float":
            return "{:.2f}".format(value)
        return str(value)

    def change(self, field, direction, big=False):
        if field.kind == "bool":
            self.settings[field.key] = not self.settings[field.key]
        elif field.kind in ("int", "float"):
            step = field.big_step if big else field.step
            value = self.settings[field.key] + direction * step
            value = min(max(value, field.minimum), field.maximum)
            self.settings[field.key] = round(value, 2) if field.kind == "float" else int(value)
        elif field.kind == "device":
            names = [DEFAULT_TARGET] + [device["name"] for device in self.devices]
            current = names.index(self.settings["target"]) if self.settings["target"] in names else 0
            self.settings["target"] = names[(current + direction) % len(names)]

    # -- drawing

    def put(self, y, x, text, attr=0):
        height, width = self.screen.getmaxyx()
        if 0 <= y < height and x < width - 1:
            try:
                self.screen.addnstr(y, x, text, width - 1 - x, attr)
            except curses.error:
                pass

    def draw(self):
        self.screen.erase()
        bold = curses.A_BOLD
        self.put(0, 0, "Noise Suppressor for Voice - PipeWire setup", bold | curses.A_UNDERLINE)

        y = 2
        label_width = max(len(field.label) for field in FIELDS) + 2
        for index, field in enumerate(FIELDS):
            attr = curses.A_REVERSE if index == self.selected else 0
            self.put(y, 2, field.label.ljust(label_width), attr)
            self.put(y, 2 + label_width, " " + self.value_text(field) + " ", attr | bold)
            y += 1

        y += 1
        self.put(y, 2, FIELDS[self.selected].help_text, curses.A_DIM)
        y += 1
        self.put(y, 2, "Latency: {} ms".format(latency_ms(self.settings)))
        y += 2

        self.put(y, 0, "Status", bold)
        y += 1
        self.put(y, 2, "Setup: " + setup_description(self.setup))
        y += 1
        for problem in self.setup["server_problems"] + [self.setup["version_problem"]]:
            if problem:
                self.put(y, 2, "PROBLEM: " + problem)
                y += 1
        if self.plugin_path:
            self.put(y, 2, "Plugin: " + self.plugin_path)
        elif self.test_plugin_path:
            self.put(y, 2, "Plugin: NOT FOUND for PipeWire. Only LADSPA_PATH of this shell has " +
                     self.test_plugin_path)
        else:
            other = find_plugin_outside_search_path()
            text = "Plugin: NOT FOUND in the PipeWire LADSPA search path"
            if other:
                text += " (PipeWire does not load {})".format(other)
            self.put(y, 2, text)
        y += 1
        if self.test_plugin_path and self.test_plugin_path != self.plugin_path:
            self.put(y, 2, "The echo test uses {}, from LADSPA_PATH of this shell.".format(self.test_plugin_path))
            y += 1
            self.put(y, 2, "The PipeWire daemon does not get this LADSPA_PATH. "
                           "Install the plugin in /usr/lib/ladspa, or see: systemctl --user set-environment")
            y += 1
        if self.service:
            self.put(y, 2, "filter-chain.service: {} ({})".format(*self.service))
            y += 1
        if self.target_missing():
            self.put(y, 2, "The selected microphone is not connected. PipeWire uses the default input instead.")
            y += 1
        if self.running_node:
            source = "running (node {})".format(self.running_node["id"])
            if self.default_source == SOURCE_NODE_NAME:
                source += ", default input"
        else:
            source = "not running"
        self.put(y, 2, "Denoised source: " + source)
        y += 1
        for path in self.conflicts:
            self.put(y, 2, "Other config that loads the plugin: " + path)
            y += 1

        y += 1
        for text in self.messages:
            self.put(y, 2, text)
            y += 1

        height, _ = self.screen.getmaxyx()
        self.put(height - 1, 0, KEYS_HELP, curses.A_REVERSE)
        self.screen.refresh()

    # -- dialogs

    def ask_yes_no(self, question):
        lines = question.split("\n")
        while True:
            self.screen.erase()
            for index, line in enumerate(lines):
                self.put(1 + index, 2, line)
            self.put(2 + len(lines), 2, "[y] Yes   [n] No", curses.A_BOLD)
            self.screen.refresh()
            key = self.screen.getch()
            if key in (ord("y"), ord("Y")):
                return True
            if key in (ord("n"), ord("N"), 27, ord("q")):
                return False

    def edit_text(self, title, value):
        curses.curs_set(1)
        text = value
        while True:
            self.screen.erase()
            self.put(1, 2, title, curses.A_BOLD)
            self.put(3, 2, "> " + text)
            self.put(5, 2, "Enter: save   Esc: cancel", curses.A_DIM)
            self.screen.move(3, min(4 + len(text), self.screen.getmaxyx()[1] - 2))
            self.screen.refresh()
            key = self.screen.get_wch()
            if key in ("\n", "\r", curses.KEY_ENTER):
                curses.curs_set(0)
                return text
            if key == "\x1b":
                curses.curs_set(0)
                return None
            if key in (curses.KEY_BACKSPACE, "\x7f", "\b"):
                text = text[:-1]
            elif isinstance(key, str) and key.isprintable():
                text += key

    def pick_device(self):
        self.refresh_status()
        options = [(DEFAULT_TARGET, self.device_label(DEFAULT_TARGET))]
        options += [(device["name"], "{}  [{}]".format(device["description"], device["name"]))
                    for device in self.devices]
        names = [name for name, _ in options]
        index = names.index(self.settings["target"]) if self.settings["target"] in names else 0
        while True:
            self.screen.erase()
            self.put(1, 2, "Select the microphone", curses.A_BOLD)
            for row, (_, label) in enumerate(options):
                self.put(3 + row, 4, label, curses.A_REVERSE if row == index else 0)
            self.put(4 + len(options), 2, "Enter: select   Esc: cancel   r: refresh", curses.A_DIM)
            self.screen.refresh()
            key = self.screen.getch()
            if key == curses.KEY_UP:
                index = (index - 1) % len(options)
            elif key == curses.KEY_DOWN:
                index = (index + 1) % len(options)
            elif key in (10, 13, curses.KEY_ENTER):
                self.settings["target"] = options[index][0]
                return
            elif key in (27, ord("q")):
                return
            elif key == ord("r"):
                return self.pick_device()

    def progress(self, title, lines=()):
        self.screen.erase()
        self.put(1, 2, title, curses.A_BOLD)
        for index, line in enumerate(lines):
            self.put(3 + index, 2, line)
        self.screen.refresh()

    # -- actions

    def check_ready(self, for_apply):
        """Returns True if the echo test (for_apply False) or apply can run. Else shows why not."""
        tools = missing_tools()
        if tools:
            self.message("Missing commands: " + ", ".join(tools))
            return False
        problems = list(self.setup["server_problems"])
        if for_apply and self.setup["version_problem"]:
            problems.append(self.setup["version_problem"])
        if problems:
            for problem in problems:
                self.message(problem)
            return False
        plugin = self.plugin_path if for_apply else self.test_plugin_path
        if not plugin:
            if for_apply and self.test_plugin_path:
                self.message("The PipeWire daemon does not find {}. Only LADSPA_PATH of this shell has it."
                             .format(PLUGIN_FILE_NAME))
            else:
                self.message("{} is not installed in a LADSPA search path.".format(PLUGIN_FILE_NAME))
            return False
        return True

    def echo_test(self):
        if not self.check_ready(for_apply=False):
            return
        if self.target_missing():
            self.message("The selected microphone is not connected. Select another one for the test.")
            return
        raw_target = resolve_raw_target(self.settings)
        if raw_target is None:
            self.message("No microphone found. Select a microphone for the test.")
            return

        test = EchoTest(dict(self.settings), raw_target)
        try:
            self.progress("Echo test", ["Starting a temporary filter with the current settings..."])
            if not test.start_chain():
                self.message("The test filter did not start. PipeWire says:")
                for line in test.error_lines() or ["(no output)"]:
                    self.message("  " + line)
                return

            # The filter must run for a short time before the recording starts.
            time.sleep(0.5)
            test.start_recording()
            seconds = self.settings["test_seconds"]
            start = time.monotonic()
            self.screen.timeout(100)
            cancelled = False
            while True:
                left = seconds - (time.monotonic() - start)
                if left <= 0:
                    break
                bar_width = 40
                done = int(bar_width * (1 - left / seconds))
                self.progress("Echo test - RECORDING", [
                    "Speak now. Make some noise too, for example typing.",
                    "Microphone: " + self.device_label(raw_target),
                    "",
                    "[" + "#" * done + "." * (bar_width - done) + "] {:.1f} s".format(left),
                    "",
                    "Esc: cancel",
                ])
                if self.screen.getch() == 27:
                    cancelled = True
                    break
            self.screen.timeout(-1)
            test.stop()
            if cancelled:
                self.message("Echo test cancelled.")
                return
            self.playback_menu(test)
        finally:
            self.screen.timeout(-1)
            test.cleanup()

    def playback_menu(self, test):
        raw_level = wav_level_db(test.raw_path)
        denoised_level = wav_level_db(test.denoised_path)

        def level_text(level):
            if level is None:
                return "no data"
            return "average {:.1f} dB, noise floor {:.1f} dB".format(*level)

        lines = [
            "Denoised: " + level_text(denoised_level),
            "Raw:      " + level_text(raw_level),
            "",
            "[d] play denoised   [r] play raw   [Esc] back",
            "Any key stops the playback.",
        ]
        self.play(test.denoised_path, "Playing denoised recording...", lines)
        while True:
            self.progress("Echo test - results", lines)
            key = self.screen.getch()
            if key == ord("d"):
                self.play(test.denoised_path, "Playing denoised recording...", lines)
            elif key == ord("r"):
                self.play(test.raw_path, "Playing raw recording...", lines)
            elif key in (27, ord("q")):
                return

    def play(self, path, title, lines):
        if not os.path.exists(path):
            return
        player = subprocess.Popen(["pw-play", path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self.screen.timeout(100)
        try:
            while player.poll() is None:
                self.progress(title, lines)
                if self.screen.getch() != -1:
                    player.terminate()
                    break
        finally:
            self.screen.timeout(-1)
            try:
                player.wait(timeout=2)
            except subprocess.TimeoutExpired:
                player.kill()

    def restart_text(self):
        """Returns what apply and remove restart, for the questions."""
        if self.mode == MODE_FILTER_CHAIN:
            return "restart filter-chain.service.\nOnly the denoised source restarts. Other audio does not stop."
        if self.setup["pipewire_service"]:
            return "restart pipewire.service.\nAll audio stops for a moment."
        return "not restart anything. " + MANUAL_RESTART_TEXT

    def apply(self):
        if not self.check_ready(for_apply=True):
            return
        if self.settings["make_default"] and not self.settings["target"]:
            self.message("Select a microphone. The default input cannot be both the input and the output.")
            return
        if self.target_missing() and not self.ask_yes_no(
                "The selected microphone is not connected:\n  {}\n\n"
                "Until it is connected, PipeWire uses the default input. Apply anyway?".format(self.settings["target"])):
            return

        path = config_path(self.mode)
        disable_conflicts = False
        if self.conflicts:
            question = ("These configs also load the plugin:\n  " + "\n  ".join(self.conflicts) +
                        "\n\nThey conflict with the new config. Rename them to *.disabled?\n"
                        "Then write {} and {}").format(path, self.restart_text())
            if self.mode == MODE_FILTER_CHAIN:
                question += "\nTo unload the old configs, pipewire.service restarts once. All audio stops for a moment."
            if not self.ask_yes_no(question):
                self.message("Apply cancelled. The old config is unchanged.")
                return
            disable_conflicts = True
        elif not self.ask_yes_no("Write {}\nand {}".format(path, self.restart_text())):
            return

        old_text = read_text(path)
        self.progress("Applying...")
        result = apply_settings(self.settings, self.setup, disable_conflicts, self.message)
        if result == APPLY_FAILED and os.path.exists(path):
            question = ("The denoised source did not start. The messages show why.\n\n" +
                        ("Restore the previous config?" if old_text is not None else "Remove the new config?"))
            self.refresh_status()
            self.draw()
            if self.ask_yes_no(question):
                self.progress("Restoring...")
                restore_config(self.setup, old_text, self.message)
        self.refresh_status()

    def remove(self):
        path = config_path(self.mode)
        if not os.path.exists(path):
            self.message("Nothing to remove: " + path)
            return
        if not self.ask_yes_no("Delete {}\nand {}".format(path, self.restart_text())):
            return
        remove_setup(dict(self.setup, mode=self.mode), self.message)
        self.refresh_status()

    # -- main loop

    def loop(self):
        while True:
            self.draw()
            key = self.screen.getch()
            field = FIELDS[self.selected]
            # Esc does not quit. An unknown key sequence starts with Esc too.
            if key == ord("q"):
                return
            if key == curses.KEY_UP:
                self.selected = (self.selected - 1) % len(FIELDS)
            elif key == curses.KEY_DOWN:
                self.selected = (self.selected + 1) % len(FIELDS)
            elif key in (curses.KEY_LEFT, ord("-")):
                self.change(field, -1)
            elif key in (curses.KEY_RIGHT, ord("+"), ord("=")):
                self.change(field, 1)
            elif key == curses.KEY_PPAGE:
                self.change(field, 1, big=True)
            elif key == curses.KEY_NPAGE:
                self.change(field, -1, big=True)
            elif key in (10, 13, curses.KEY_ENTER, ord(" ")):
                self.edit(field)
            elif key == ord("e"):
                self.echo_test()
            elif key == ord("a"):
                self.apply()
            elif key == ord("x"):
                self.remove()
            elif key == ord("r"):
                self.refresh_status()
            elif key == curses.KEY_RESIZE:
                pass

    def edit(self, field):
        if field.kind == "device":
            self.pick_device()
        elif field.kind == "bool":
            self.change(field, 1)
        elif field.kind == "text":
            text = self.edit_text(field.label, self.settings[field.key])
            if text and text.strip():
                self.settings[field.key] = text.strip()
        else:
            text = self.edit_text("{} ({} .. {})".format(field.label, field.minimum, field.maximum),
                                  str(self.settings[field.key]))
            if text is None:
                return
            try:
                value = float(text)
            except ValueError:
                self.message("Not a number: " + text)
                return
            value = min(max(value, field.minimum), field.maximum)
            if field.key == "retroactive_grace_ms":
                value = value // 10 * 10
            self.settings[field.key] = round(value, 2) if field.kind == "float" else int(value)


def main_ui(screen):
    curses.curs_set(0)
    screen.keypad(True)
    curses.use_default_colors()
    App(screen).loop()


def main():
    parser = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    parser.add_argument("--print-config", action="store_true",
                        help="print the config for the saved settings and exit")
    args = parser.parse_args()

    if args.print_config:
        setup = detect_setup(pw_dump())
        settings, _ = load_settings(setup["mode"] or MODE_FILTER_CHAIN)
        sys.stdout.write(generate_config(settings))
        return 0

    os.environ.setdefault("ESCDELAY", "25")
    curses.wrapper(main_ui)
    return 0


if __name__ == "__main__":
    sys.exit(main())
